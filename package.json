{
  "name": "seebo",
  "version": "0.4.1",
  "description": "Suspendable Evaluation Engine Built with Opus — a typed, suspendable expression/template engine with a pure synchronous core.",
  "type": "module",
  "license": "MIT",
  "author": "Fedebb",
  "homepage": "https://github.com/BoniFederico/seebo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoniFederico/seebo.git"
  },
  "bugs": {
    "url": "https://github.com/BoniFederico/seebo/issues"
  },
  "keywords": [
    "template",
    "template-engine",
    "evaluation",
    "interpreter",
    "expression",
    "suspendable",
    "resumable",
    "state-machine",
    "typed",
    "pure",
    "deterministic"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./actions": "./src/actions/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:conformance": "node --test \"test/conformance/**/*.test.js\"",
    "test:watch": "node --test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/index.js",
    "bench:gc": "node --expose-gc bench/index.js",
    "bench:smoke": "node bench/index.js --smoke",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.7.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
