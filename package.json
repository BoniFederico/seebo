{
  "name": "seebo",
  "version": "0.1.0",
  "description": "Seebo — Suspendable Evaluation Engine Built with Opus",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:conformance": "node --test \"test/conformance/**/*.test.js\"",
    "test:watch": "node --test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/index.js",
    "bench:gc": "node --expose-gc bench/index.js",
    "bench:smoke": "node bench/index.js --smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.7.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
